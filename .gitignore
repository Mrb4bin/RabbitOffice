# Dependencies
node_modules/

# Build output (installers go to GitHub Releases, not into the repo)
desktop/dist/

# Copies of web/ and shared/ made by scripts/copy-assets.js before packaging
desktop/web/
desktop/shared/
android/www/

# Native Android project, generated by `npx cap add android` (CI does it on every build)
android/android/

# Android signing key and its password: keep a backup, never publish
android/keystore/
*.jks
*.keystore

# Finished installers collected for a GitHub Release
release/

# Clean copy of the repository files for uploading through the GitHub website
github-upload/

# Local server data: users, passwords, files, certificates
server/data/
rabbit-office-backup-*.tar.gz

# Editor / OS / tool files
.claude/
.vscode/
.idea/
*.log
.DS_Store
Thumbs.db
